<?xml version="1.0" encoding="utf-8"?>
<!-- 30 min es lo mínimo que Android permite para la actualización automática; tocar la hora actualiza al momento -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="50dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_clima"
    android:previewLayout="@layout/widget_clima"
    android:configure="py.clima.app.ConfigWidget"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen"
    android:description="@string/widget_desc" />
