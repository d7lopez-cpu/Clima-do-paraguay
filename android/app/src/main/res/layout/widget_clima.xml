<?xml version="1.0" encoding="utf-8"?>
<!-- Widget normal (3×2 o más). Los textos de ejemplo se ven en la vista previa del selector de widgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Ñandutí de marca de agua, asomando por la esquina -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="-46dp"
        android:layout_marginBottom="-52dp"
        android:alpha="0.13"
        android:importantForAccessibility="no"
        android:src="@drawable/nanduti" />

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ciudad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="Asunción"
                android:textColor="@color/texto"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:text="21:30"
                android:textColor="@color/texto_suave"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Línea fina con los colores de la bandera -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <ImageView android:layout_width="12dp" android:layout_height="2dp" android:background="@color/rojo" android:importantForAccessibility="no" />
            <ImageView android:layout_width="12dp" android:layout_height="2dp" android:layout_marginStart="2dp" android:background="#FFFFFF" android:importantForAccessibility="no" />
            <ImageView android:layout_width="12dp" android:layout_height="2dp" android:layout_marginStart="2dp" android:background="@color/azul" android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:singleLine="true"
                android:text="27°"
                android:textColor="@color/texto"
                android:textSize="50sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icono"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:src="@drawable/ic_parcial" />

                <TextView
                    android:id="@+id/estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:maxWidth="150dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Parcialmente nublado"
                    android:textColor="@color/texto"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/maxima"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Máx 31°"
                        android:textColor="@color/sol"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/minima"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Mín 22°"
                        android:textColor="@color/celeste"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
